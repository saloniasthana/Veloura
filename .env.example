# Get a free Postgres database from https://neon.com — copy the connection
# string it gives you (it already includes ?sslmode=require).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Generate a random value for local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-secret"

# Only needed in production (Vercel) — Vercel adds this automatically once
# you create a Blob store and connect it to the project. Leave unset locally
# and product photo uploads will fall back to saving on local disk.
BLOB_READ_WRITE_TOKEN=""

# Public site URL, used for absolute links (logo for Google search results).
# Optional on Vercel — the production domain is picked up automatically.
NEXT_PUBLIC_SITE_URL=""
